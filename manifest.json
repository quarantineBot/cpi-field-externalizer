{
  "manifest_version": 3,
  "name": "iFlow Field Externalizer",
  "version": "1.2.0",
  "description": "Externalize hardcoded fields in SAP Integration Suite iFlows to {{parameters}}, and manage default & configured parameter values — in the editor.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "iFlow Field Externalizer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hana.ondemand.com/shell/*",
        "https://*.hana.ondemand.com/itspaces/*",
        "https://*.platform.sapcloud.cn/shell/*",
        "https://*.platform.sapcloud.cn/itspaces/*"
      ],
      "js": [
        "vendor/jszip.min.js",
        "src/engine/engine.js",
        "src/engine/pvm.js",
        "src/plugin/field-externalizer.plugin.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
